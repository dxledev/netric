[Unit]
Description=Netric FastAPI backend
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=__NETRIC_USER__
Group=__NETRIC_GROUP__
WorkingDirectory=__NETRIC_BACKEND_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=MONGO_INIT_RETRIES=12
Environment=MONGO_INIT_RETRY_DELAY_SECONDS=10
Environment=MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
ExecStart=__NETRIC_PYTHON_BIN__ -m uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
